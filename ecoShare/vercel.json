{
  "version": 2,
  "builds": [
    {
      "src": "src/app.js",
      "use": "@vercel/node",
      "config": {
        "nodeOptions": "--experimental-sqlite"
      }
    }
  ],
  "routes": [
    {
      "src": "/public/(.*)",
      "dest": "/src/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "src/app.js"
    }
  ],
  "env": {
    "JWT_SECRET": "@jwt_secret",
    "NODE_ENV": "production",
  "TZ": "America/Sao_Paulo"
  }
}
